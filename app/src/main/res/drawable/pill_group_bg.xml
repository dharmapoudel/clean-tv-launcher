<?xml version="1.0" encoding="utf-8"?>
<!-- The shared pill behind the grouped top buttons (Inputs + Wi-Fi): the same glass as
     pill_bg's default state. The group itself is never focused — focus lives on the
     buttons inside it, which paint their own disc (pill_inner_bg). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0DFFFFFF" />
    <stroke android:width="1dp" android:color="#38FFFFFF" />
    <corners android:radius="21dp" />
</shape>
